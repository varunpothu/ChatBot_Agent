APP_ENV=development
LOG_LEVEL=INFO

# Provider routing
LLM_PROVIDER=auto
LLM_ENABLED=true
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
GROQ_API_KEY=
GROQ_MODEL=
AWS_REGION=eu-west-2

# Strict cost and latency budgets
MAX_INPUT_CHARS=1400
TOP_K_CANDIDATES=8
TOP_K_FINAL=3
MAX_EVIDENCE_CHARS=3600
MAX_OUTPUT_TOKENS=180
DEEP_WORD_LIMIT=20
LOW_RETRIEVAL_SCORE=0.18
LLM_TIMEOUT_SECONDS=8
RESPONSE_CACHE_TTL_SECONDS=300

# Voice
TTS_MODE=browser
POLLY_ENGINE=neural
DOCUMENT_STORAGE_PATH=./data/documents

# Evaluation targets
GROUNDING_THRESHOLD=0.80
RETRIEVAL_RECALL_GATE=0.80
CITATION_ACCURACY_GATE=0.90
LATENCY_GATE_MS=3000
