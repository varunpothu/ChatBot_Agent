APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=auto
LLM_ENABLED=true
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=512
GROQ_API_KEY=
GROQ_MODEL=
AWS_REGION=eu-west-2

TRANSLATION_PROVIDER=none
MULTILINGUAL_EMBEDDING_PROVIDER=auto
MULTILINGUAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MULTILINGUAL_EMBEDDING_DEVICE=cpu
MULTILINGUAL_EMBEDDING_BATCH_SIZE=16

MAX_INPUT_CHARS=1400
TOP_K_CANDIDATES=8
TOP_K_FINAL=3
MAX_EVIDENCE_CHARS=3600
MAX_OUTPUT_TOKENS=180
DEEP_WORD_LIMIT=20
LOW_RETRIEVAL_SCORE=0.18
LLM_TIMEOUT_SECONDS=8
RESPONSE_CACHE_TTL_SECONDS=300
MAX_LLM_CALLS_PER_DAY=1000
MAX_REQUESTS_PER_MINUTE=30
MAX_UPLOAD_MB=25

TTS_MODE=browser
TTS_CACHE_TTL_SECONDS=3600
POLLY_ENGINE=neural
DOCUMENT_STORAGE_PATH=./data/documents

ADMIN_API_KEY=

GROUNDING_THRESHOLD=0.80
RETRIEVAL_RECALL_GATE=0.80
CITATION_ACCURACY_GATE=0.90
LATENCY_GATE_MS=3000

# Production persistence / async ingestion
DATABASE_URL=
REDIS_URL=
REDIS_RATE_LIMIT_FAIL_OPEN=false
EMBEDDING_CACHE_TTL_SECONDS=900
POSTGRES_AUTO_INIT_SCHEMA=false
INGESTION_MODE=inline
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=documents
DOCUMENT_INGESTION_QUEUE_URL=
INGESTION_VISIBILITY_TIMEOUT_SECONDS=300
